# ── 클라이언트 (공개 가능한 값만. Vite가 번들에 포함시킨다) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=     # 브라우저용: HTTP 리퍼러 제한 + Maps JS / Places API(New)만 허용
VITE_GOOGLE_MAP_ID=               # Cloud Console에서 만든 Map ID (AdvancedMarker 필수)
VITE_APP_BASE_URL=http://localhost:5173

# ── Edge Function 시크릿 (절대 커밋 금지). 설정 방법: supabase secrets set KEY=VALUE ──
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_SERVER_KEY=              # 서버용: Places API(New) + Routes API만 허용(API 제한)
# DEFAULT_GEMINI_MODEL=           # 구현 시점에 공식 문서에서 현재 모델명을 확인해서 지정
# DEFAULT_OPENROUTER_MODEL=
# DAILY_LIMIT_AI=60
# DAILY_LIMIT_ROUTES=400
# DAILY_LIMIT_RECEIPT=30
# DAILY_LIMIT_RESERVATION=30
# DAILY_LIMIT_RECAP=10
# APP_BASE_URL=                   # CORS 허용 출처 (배포 도메인)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는 Edge Function에 자동 주입됨
